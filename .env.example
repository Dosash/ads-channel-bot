BOT_TOKEN=
CRYPTOPAY_TOKEN=
# через запятую, если админов несколько
ADMIN_IDS=
DB_PATH=data/bot.db
# true — использовать тестовую сеть CryptoBot (testnet-pay.crypt.bot)
CRYPTOPAY_TESTNET=false
# Тестовый режим: все тестовые заказы публикуются только сюда
TEST_CHANNEL_ID=
# Необязательно: токен из @CryptoTestnetBot для оплаты тестовых заказов ненастоящей криптой
CRYPTOPAY_TESTNET_TOKEN=

# ---------- расписание публикаций ----------
TIMEZONE=Europe/Moscow
# часы, в которые можно публиковать (слоты по часу, включительно): 9-22 → 09:00 … 22:00
WORK_HOURS=9-22
# на сколько дней вперёд можно бронировать
BOOKING_DAYS=14
# минимум минут до публикации при бронировании (время на модерацию)
MIN_LEAD_MINUTES=60

# ---------- xRocket Pay (@xrocket) ----------
# @xRocket → Rocket Pay → приложение → API Token (Bearer-токен нового Pay API)
XROCKET_TOKEN=
# нужен только при приёме вебхуков (сейчас оплата проверяется опросом)
XROCKET_WEBHOOK_TOKEN=

# ---------- веб-панель ----------
PANEL_HOST=0.0.0.0
# 0 — не запускать панель
PANEL_PORT=8093
# путь панели: http://<сервер>:8093/ads/
PANEL_PREFIX=/ads
# пароль входа в панель; пусто — без логина (только если панель не видна из интернета!)
PANEL_PASSWORD=
